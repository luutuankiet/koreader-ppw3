# Copy to .env (gitignored). Every value here is a placeholder.
# Public base URL the phone and Google redirect to; the callback is <BASE_URL>/auth/callback.
BASE_URL=http://127.0.0.1:8080
# Google accounts allowed to sign in, as comma-separated SHA-256 hex of each lowercased email:
#   printf '%s' owner@example.com | sha256sum
# Any other account must also be a test user on the OAuth consent screen while the app is in Testing mode.
# deploy.sh also accepts OWNER_EMAIL=<email>[,<email>] here and hashes it locally; the plain email never reaches Cloud Run.
OWNER_EMAIL_SHA256=PLACEHOLDER_SHA256_HEX
GOOGLE_CLIENT_ID=PLACEHOLDER.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PLACEHOLDER
# State: a GCS bucket in production, or a local JSON file for development.
STATE_BUCKET=
STATE_OBJECT=gdrive-epub/state.json
STATE_FILE=./state.json
# Development only: use this Google access token instead of the stored refresh token.
# The server refuses to start with it set on Cloud Run (K_SERVICE set).
DEV_ACCESS_TOKEN=
# Development only: quota project header for a gcloud user token (Drive refuses user ADC tokens without one).
DEV_QUOTA_PROJECT=
# Development only: accept this device key without pairing.
DEV_DEVICE_KEY=

# ---- Cloud Run deploy (read by deploy.sh; the service itself never reads these) ----
GCP_PROJECT=my-project
GCP_PROJECT_NUMBER=123456789012
REGION=asia-southeast1
SERVICE=gdrive-epub
# Service account name (without @...); created if missing.
SERVICE_ACCOUNT=gdrive-epub-run
# Private bucket for the state object; created if missing. Bucket names may not contain "google".
STATE_BUCKET=my-project-gdrive-epub-state
# Existing Secret Manager secret holding the OAuth Web client's secret, and a pinned version number.
CLIENT_SECRET_SECRET=my-oauth-client-secret
CLIENT_SECRET_VERSION=1
# Optional: command used to run gcloud, e.g. a wrapper that picks the right account.
GCLOUD=gcloud
