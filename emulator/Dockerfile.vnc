# VNC view of the emulator's screen: x11vnc on the emulator's Xvfb display,
# plus noVNC in the browser. Runs beside koreader-emu (see docker-compose.yml).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      x11vnc novnc websockify x11-utils \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s vnc.html /usr/share/novnc/index.html

COPY vnc.sh /usr/local/bin/vnc.sh
RUN chmod +x /usr/local/bin/vnc.sh

ENV DISPLAY=:73 VNC_PORT=5973 NOVNC_PORT=6073
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/vnc.sh"]
