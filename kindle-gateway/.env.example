# Copy to .env (gitignored). Read automatically by docker compose.
# Host path of the workspace, mounted read-only at /workspace. Default: repo root.
WORKSPACE_DIR=..
# Port the gateway listens on (container uses host networking).
GATEWAY_PORT=9999
# LAN port devices dial out to and hold open in live mode. Must match the plugin's gateway address.
DEVICE_PORT=9990
# Milliseconds to wait for the e-ink refresh before taking a screenshot.
EINK_DELAY=1500
# Host user the container runs as; it owns the bundles written into the inbox.
GATEWAY_UID=1000
GATEWAY_GID=1000
# Host folder of plugin packages: scripts/publish.sh writes here, the gateway
# serves it read-only at /pkg/. Create it before starting the container.
PKG_HOST_DIR=${HOME}/kindle-packages/pkg
# Host folder receiving device uploads at /inbox/<device>/<file>.tar.gz.
# Create it before starting the container, or Docker creates it owned by root
# and every upload fails.
INBOX_HOST_DIR=${HOME}/kindle-packages/inbox
# Largest accepted upload, in bytes (10 MiB).
INBOX_MAX_BYTES=10485760
