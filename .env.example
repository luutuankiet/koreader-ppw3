# Values that evidence/ files name as $KEY instead of spelling out.
# Copy to .env (gitignored) and fill in to rehydrate a snapshot.

# what: full base URL of the owner's kosync progress-sync server
KOSYNC_URL=
# what: hostname part of KOSYNC_URL, as it appears without a scheme
KOSYNC_HOST=
# what: kosync test account user name
KOSYNC_USER=
# what: kosync test account password
KOSYNC_PASSWORD=
# what: kosync test account key (md5 of the password, as kosync sends it)
KOSYNC_KEY=
