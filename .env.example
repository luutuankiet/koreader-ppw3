# Copy to .env (gitignored) and fill in. Evidence files under evidence/ name these
# values as $KEY; `envscan hydrate <file>` puts them back.

# what: base URL of the KOReader progress sync server
KOSYNC_URL=
# what: user name on the progress sync server
KOSYNC_USER=
# what: password on the progress sync server
KOSYNC_PASSWORD=
# what: the sync user key (md5 of the password) KOReader sends
KOSYNC_KEY=
# what: host name of the progress sync server
KOSYNC_HOST=

# what: bearer key agents send to the Cloudflare gateway's /mcp endpoint
KINDLE_GW_AGENT_KEY=
# what: key devices send when they connect to the Cloudflare gateway's /device endpoint
KINDLE_GW_DEVICE_KEY=
# what: Cloudflare account id that owns the gateway Worker
CF_ACCOUNT_ID=
# what: Cloudflare zone id of the domain the gateway is served on
CF_ZONE_ID=
# what: public IP address the operator's machine reached the gateway from in recorded runs
OPERATOR_PUBLIC_IP=
# what: id of the gateway Worker's Durable Object namespace in Cloudflare analytics
CF_DO_NAMESPACE_ID=
